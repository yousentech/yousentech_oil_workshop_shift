                                        <th>Date</th>
                                        <th>Customer</th>
                                        <th>Invoice</th>
                                        <th>Total Include Tax</th>
                                        <th>Pay Cash</th>
                                        <th>Pay Bank</th>
                                        <th>Remaining</th>
                                        <th>Branch</th>
                                        <th>Car Type</th>
                                        <th>Car Plate</th>
                                        <th>Car Size</th>
                                        <th>Shift</th>

                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="l_cnt" t-value="0"/>
                                    <t t-set="l_amount_total" t-value="0"/>
                                    <t t-set="l_cash_all" t-value="0"/>
                                    <t t-set="l_bank_all" t-value="0"/>

                                    <t t-foreach="docs_compelete.filtered(lambda x: x.work_order_id.salesman_id.id == rec.id)" t-as="move">
                                        <t t-set="l_cnt" t-value="l_cnt + 1"/>
                                        <t t-set="invoice_amount" t-value="0"/>
                                        <t t-if="move.move_type == 'out_invoice'">
                                            <t t-set="invoice_amount" t-value="move.amount_total"/>
                                            <t t-set="l_amount_total" t-value="invoice_amount + l_amount_total"/>
                                            <t t-set="l_amount_total_all" t-value="invoice_amount + l_amount_total_all"/>
                                        </t>
                                        <t t-if="move.move_type == 'out_refund'">
                                            <t t-set="invoice_amount" t-value="move.amount_total * -1"/>
                                            <t t-set="l_amount_total" t-value="invoice_amount + l_amount_total"/>
                                            <t t-set="l_amount_total_all" t-value="invoice_amount + l_amount_total_all"/>
                                        </t>
                                        <t t-set="l_cash" t-value="move.get_payment_amt_of_invoice('cash')"/>
                                        <t t-set="l_bank" t-value="move.get_payment_amt_of_invoice('bank')"/>
                                        <t t-set="l_cash_all" t-value="l_cash + l_cash_all"/>
                                        <t t-set="l_bank_all" t-value="l_bank + l_bank_all"/>

                                        <tr>
                                            <td><t t-esc="l_cnt"/></td>
                                            <td><t t-esc="move.work_order_id.order_seq"/></td>
                                            <td><t t-esc="move.date"/></td>
                                            <td><t t-esc="move.partner_id.name"/></td>
                                            <td><t t-esc="move.name"/></td>
                                            <td style="text-align:right;"><t t-esc="round(invoice_amount,2)"/></td>
                                            <td style="text-align:right;"><t t-esc="l_cash"/></td>
                                            <td style="text-align:right;"><t t-esc="l_bank"/></td>
                                            <td style="text-align:right;"><t t-esc="round(invoice_amount - (l_cash + l_bank),2)"/></td>
                                            <td><t t-esc="move.company_id.name"/></td>
                                            <td><t t-esc="move.work_order_id.car_type_id.name"/></td>
                                            <td><t t-esc="move.work_order_id.car_number"/></td>
                                            <td><t t-esc="move.work_order_id.car_size_id.name"/></td>
                                             <td><t t-esc="move.work_order_id.shift_id.name"/></td>

                                        </tr>
                                    </t>
                                </tbody>

                                <tr class="summary-row">
                                    <td colspan="5">Total</td>
                                    <td><t t-esc="'{:,.2f}'.format(l_amount_total)"/></td>
                                    <td><t t-esc="'{:,.2f}'.format(l_cash_all)"/></td>
                                    <td><t t-esc="'{:,.2f}'.format(l_bank_all)"/></td>
                                    <td><t t-esc="'{:,.2f}'.format(l_amount_total - (l_cash_all + l_bank_all))"/></td>
                                    <td colspan="5"></td>
                                </tr>
                            </table>
                            <p style="page-break-after:always;"></p>
                        </t>
                    </t>

                    <t t-if="group_by_type == 'by_technical'">
                        <t t-foreach="technicians" t-as="rec">
                            <br/>

                            <div class="section-header">
                                Technician Name: <span t-esc="rec.name"/>
                            </div>

                            <table>
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Work Order</th>
                                        <th>Date</th>
                                        <th>Customer</th>
                                        <th>Invoice</th>
                                        <th>Total Include Tax</th>
                                        <th>Pay Cash</th>
                                        <th>Pay Bank</th>
                                        <th>Remaining</th>
                                        <th>Branch</th>
                                        <th>Car Type</th>
                                        <th>Car Plate</th>
                                        <th>Car Size</th>
                                        <th>Shift</th>

                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="l_cnt" t-value="0"/>
                                    <t t-set="l_amount_total" t-value="0"/>
                                    <t t-set="l_cash_all" t-value="0"/>
                                    <t t-set="l_bank_all" t-value="0"/>

                                    <t t-foreach="docs_compelete.filtered(lambda x: x.work_order_id.employee_id.id == rec.id)" t-as="move">
                                        <t t-set="l_cnt" t-value="l_cnt + 1"/>
                                        <t t-set="invoice_amount" t-value="0"/>
                                        <t t-if="move.move_type == 'out_invoice'">
                                            <t t-set="invoice_amount" t-value="move.amount_total"/>
                                            <t t-set="l_amount_total" t-value="invoice_amount + l_amount_total"/>
                                            <t t-set="l_amount_total_all" t-value="invoice_amount + l_amount_total_all"/>
                                        </t>
                                        <t t-if="move.move_type == 'out_refund'">
                                            <t t-set="invoice_amount" t-value="move.amount_total * -1"/>
                                            <t t-set="l_amount_total" t-value="invoice_amount + l_amount_total"/>
                                            <t t-set="l_amount_total_all" t-value="invoice_amount + l_amount_total_all"/>
                                        </t>
                                        <t t-set="l_cash" t-value="move.get_payment_amt_of_invoice('cash')"/>
                                        <t t-set="l_bank" t-value="move.get_payment_amt_of_invoice('bank')"/>
                                        <t t-set="l_cash_all" t-value="l_cash + l_cash_all"/>
                                        <t t-set="l_bank_all" t-value="l_bank + l_bank_all"/>

                                        <tr>
                                            <td><t t-esc="l_cnt"/></td>
                                            <td><t t-esc="move.work_order_id.order_seq"/></td>
                                            <td><t t-esc="move.date"/></td>
                                            <td><t t-esc="move.partner_id.name"/></td>
                                            <td><t t-esc="move.name"/></td>
                                            <td style="text-align:right;"><t t-esc="round(invoice_amount,2)"/></td>
                                            <td style="text-align:right;"><t t-esc="l_cash"/></td>
                                            <td style="text-align:right;"><t t-esc="l_bank"/></td>
                                            <td style="text-align:right;"><t t-esc="round(invoice_amount - (l_cash + l_bank),2)"/></td>
                                            <td><t t-esc="move.company_id.name"/></td>
                                            <td><t t-esc="move.work_order_id.car_type_id.name"/></td>
                                            <td><t t-esc="move.convert_english_to_arabic_letters(move.car_letters)"/>
                                                <span t-esc="move.work_order_id.car_letters"/>
                                                <span t-esc="move.work_order_id.car_number"/>
                                            </td>
                                            <td><t t-esc="move.work_order_id.car_size_id.name"/></td>
                                             <td><t t-esc="move.work_order_id.shift_id.name"/></td>

                                        </tr>
                                    </t>
                                </tbody>

                                <tr class="summary-row">
                                    <td colspan="5">Total</td>
                                    <td><t t-esc="'{:,.2f}'.format(l_amount_total)"/></td>
                                    <td><t t-esc="'{:,.2f}'.format(l_cash_all)"/></td>
                                    <td><t t-esc="'{:,.2f}'.format(l_bank_all)"/></td>
                                    <td><t t-esc="'{:,.2f}'.format(l_amount_total - (l_cash_all + l_bank_all))"/></td>
                                    <td colspan="5"></td>
                                </tr>
                            </table>
                            <p style="page-break-after:always;"></p>
                        </t>
                    </t>

                          
                    <t t-if="group_by_type == 'by_branch'">
                        <t t-foreach="companys" t-as="rec">
                            <br/>

                            <div class="section-header">
                                Branch Name: <span t-esc="rec.name"/>
                            </div>

                            <table>
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Work Order</th>
                                        <th>Date</th>
                                        <th>Customer</th>
                                        <th>Invoice</th>
                                        <th>Total Include Tax</th>
                                        <th>Pay Cash</th>
                                        <th>Pay Bank</th>
                                        <th>Remaining</th>
                                        <th>Technician</th>
                                        <th>Car Type</th>
                                        <th>Car Plate</th>
                                        <th>Car Size</th>
                                        <th>Shift</th>

                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="l_cnt" t-value="0"/>
                                    <t t-set="l_amount_total" t-value="0"/>
                                    <t t-set="l_cash_all" t-value="0"/>
                                    <t t-set="l_bank_all" t-value="0"/>

                                    <t t-foreach="docs_compelete.filtered(lambda x: x.work_order_id.company_id.id == rec.id)" t-as="move">
                                        <t t-set="l_cnt" t-value="l_cnt + 1"/>
                                        <t t-set="invoice_amount" t-value="0"/>
                                        <t t-if="move.move_type == 'out_invoice'">
                                            <t t-set="invoice_amount" t-value="move.amount_total"/>
                                            <t t-set="l_amount_total" t-value="invoice_amount + l_amount_total"/>
                                            <t t-set="l_amount_total_all" t-value="invoice_amount + l_amount_total_all"/>
                                        </t>
                                        <t t-if="move.move_type == 'out_refund'">
                                            <t t-set="invoice_amount" t-value="move.amount_total * -1"/>
