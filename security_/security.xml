<odoo>
  <record id="group_oil_workshop_user" model="res.groups">
    <field name="name">Oil Workshop / User</field>
    <field name="category_id" ref="base.module_category_hidden"/>
  </record>

  <record id="group_oil_workshop_manager" model="res.groups">
    <field name="name">Oil Workshop / Manager</field>
    <field name="implied_ids" eval="[(4, ref('group_oil_workshop_user'))]"/>
    <field name="category_id" ref="base.module_category_hidden"/>
  </record>

  <record id="group_oil_workshop_admin" model="res.groups">
    <field name="name">Oil Workshop / Admin</field>
    <field name="implied_ids" eval="[(4, ref('group_oil_workshop_manager'))]"/>
    <field name="category_id" ref="base.module_category_hidden"/>
  </record>
</odoo>
