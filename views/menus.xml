<odoo>
  <menuitem id="menu_oil_root" name="Oil Workshop"/>
  <menuitem id="menu_oil_operations" name="Operations" parent="menu_oil_root"/>
  <menuitem id="menu_oil_shifts" name="Shifts" parent="menu_oil_operations" action="action_oil_shift_tree"/>
  <menuitem id="menu_oil_expenses" name="Expenses" parent="menu_oil_operations" action="action_oil_expense_tree"/>
  <menuitem id="menu_oil_sales" name="Work Orders" parent="menu_oil_operations" action="action_oil_sale_tree"/>

  <record id="action_oil_shift_tree" model="ir.actions.act_window">
    <field name="name">Shifts</field>
    <field name="res_model">oil.shift</field>
    <field name="view_mode">tree,form</field>
  </record>

  <record id="action_oil_expense_tree" model="ir.actions.act_window">
    <field name="name">Expenses</field>
    <field name="res_model">oil.expense</field>
    <field name="view_mode">tree,form</field>
  </record>

  <record id="action_oil_sale_tree" model="ir.actions.act_window">
    <field name="name">Work Orders</field>
    <field name="res_model">oil.work.order</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>
