    <field name="model">oil.work.order</field>
    <field name="inherit_id" ref="yousentech_oil_workshop_shift.view_work_order_tree" ifeval="0"/>
    <field name="arch" type="xml">
          <field name = 'order_seq' position = "after" >
               <field name = "shift_id" />
          
          </field> 
    </field>
  </record>
  <record id="view_oil_work_order_form_ext" model="ir.ui.view">
