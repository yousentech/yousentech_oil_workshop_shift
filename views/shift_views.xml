<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_oil_shift_form" model="ir.ui.view">
          <field name="name">oil.shift.form</field>
          <field name="model">oil.shift</field>
          <field name="arch" type="xml">
                <form>
                  <header>
                      <field name="state" widget="statusbar"/>
                        <button name="action_open_shift" type="object" string="Open Shift" invisible="state in ['open','closed']" class="btn-primary"/>
                          <button name="action_close_shift" type="object" string="Close Shift" invisible="state != 'open'"/>
                          <button name="refresh_result" type="object" string="Refresh Data"/>
                          <button name="action_print_thermal" type="object" string="Print Thermal"/>
                          <button name="action_print_normal" type="object" string="Print Formal"/>


                  </header>
                    <sheet>

                    <!-- ======================================= -->
                    <group>
                                    <group>
                                        <group string="📦 Shift Info" col="2">
                                          <field name="name"/>
                                          <field name="user_id" readonly="1" force_save="1"/>
                                          <field name="branch_id" readonly="1" force_save="1"/>
                                          <field name="start_time" readonly="1" force_save="1"/>
                                          <field name="end_time" readonly="1" force_save="1"/>
                                             
                                        </group>
                                        <group string="📦 Payments" col="2">
                                             <field name="cash_start" readonly="state == 'closed'"/>
                                             <field name="sale_card_total"/>

                                              <field name="sale_cash_total"/>
                                              <field name="expense_total"/>
                                              <field name="expected_cash"/>
                                             
                                        </group>
                                
                                    </group>
                                    <group>

                                        <group string="📌 Cash Collection Info">
                                               <field name="expected_cash"/>
                                              <field name="cash_end" readonly="state == 'closed'"/>
                                              <field name="difference"/>
                                        </group>
                                         
                                        <group string="📌 Sales History">
                                              <field name="sale_total"/>
                                              <field name="sales_difference"/>
                                              <field name="orders_num"/>
                                              <field name="orders_invoiced_num"/>
                                              <field name="order_difference"/>
                                        </group>
                                         
                                    </group>

                                </group>
                       
                        <notebook>
                         <page string="Expenses">
                            <field name="expense_ids" readonly="state == 'closed'">
                              <tree editable="bottom" >
                                <field name="name"/>
                                <field name="amount"/>
                                <field name="date"/>
                              </tree>
                            </field>
                          </page>
                          <page string="Work Orders">
                            <field name="sale_ids" readonly="1">
                              <tree editable="bottom" >
                                <field name="order_seq"/>
                                <field name="partner_id"/>
                                <field name="amount_total"/>
                                <field name="state"/>
                              </tree>
                            </field>
                          </page>
                         
                          <page string="Notes">
                            <field name="note"/>
                          </page>
                        </notebook>
                         
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_oil_shift_tree" model="ir.ui.view">
            <field name="name">oil.shift.tree</field>
            <field name="model">oil.shift</field>
            <field name="arch" type="xml">
               <tree string="Shifts">
                  <field name="name"/>
                  <field name="user_id"/>
                  <field name="start_time"/>
                  <field name="end_time"/>
                  <field name="sale_cash_total"/>
                  <field name="expense_total"/>
                  <field name="difference"/>
                  <field name="state"/>
                </tree>
            </field>
        </record>

        

        <record id="action_oil_shift_tree" model="ir.actions.act_window">
            <field name="name">Shifts</field>
            <field name="res_model">oil.shift</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_oil_shift_tree" />
        </record>


        <menuitem id="menu_oil_shifts" name="Shifts" parent="menu_oil_shift_operations" 
            action="action_oil_shift_tree"/>

 
    </data>
</odoo>
